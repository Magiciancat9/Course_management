generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  INSTRUCTOR
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REVISION_REQUESTED
}

enum MilestoneStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionLateStatus {
  ON_TIME
  LATE
  UNKNOWN
}

model User {
  id                Int               @id @default(autoincrement())
  email             String            @unique
  fullName          String
  studentCode       String?           @unique
  passwordHash      String
  role              Role              @default(STUDENT)
  createdAt         DateTime          @default(now())

  createdTeams        ProjectTeam[]          @relation("TeamCreator")
  teamMemberships     TeamMember[]
  reviewedProposals   ProjectProposal[]      @relation("ProposalReviewer")
  updatedEvaluations  SubmissionEvaluation[] @relation("EvaluationUpdater")
  publishedGrades     GradePublication[]     @relation("GradePublisher")
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

model Course {
  id          Int           @id @default(autoincrement())
  code        String        @unique
  name        String
  term        String
  maxTeamSize Int           @default(3)
  createdAt   DateTime      @default(now())

  teams       ProjectTeam[]
  members     TeamMember[]
  milestones  Milestone[]
}

model ProjectTeam {
  id          Int                   @id @default(autoincrement())
  name        String
  courseId    Int
  createdById Int
  createdAt   DateTime              @default(now())

  course      Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("TeamCreator", fields: [createdById], references: [id])
  members     TeamMember[]
  proposal    ProjectProposal?
  submissions MilestoneSubmission[]

  @@unique([courseId, name])
}

model TeamMember {
  id         Int         @id @default(autoincrement())
  teamId     Int
  userId     Int
  courseId   Int
  memberRole String      @default("MEMBER")
  joinedAt   DateTime    @default(now())

  team       ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@unique([teamId, userId])
}

model ProjectProposal {
  id               Int            @id @default(autoincrement())
  teamId           Int            @unique
  title            String
  problemStatement String
  techStack        String
  repoUrl          String         @default("")
  status           ProposalStatus @default(DRAFT)
  reviewFeedback   String?
  reviewedById     Int?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  revisionCount    Int            @default(0)
  updatedAt        DateTime       @updatedAt

  team             ProjectTeam    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reviewedBy       User?          @relation("ProposalReviewer", fields: [reviewedById], references: [id])
}

model Milestone {
  id            Int                   @id @default(autoincrement())
  courseId      Int
  title         String
  description   String
  dueDate       DateTime
  weightPercent Int                   @default(20)
  status        MilestoneStatus       @default(DRAFT)
  publishedAt   DateTime?
  version       Int                   @default(1)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt

  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions   MilestoneSubmission[]
}

model MilestoneSubmission {
  id          Int         @id @default(autoincrement())
  milestoneId Int
  teamId      Int
  artifactUrl String
  releaseTag  String
  notes       String      @default("")
  score       Int?
  feedback    String?
  submittedAt DateTime    @default(now())
  reportUrl   String?
  version     Int         @default(1)
  dueDateSnapshot DateTime?
  lateStatus  SubmissionLateStatus @default(UNKNOWN)

  milestone    Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  team         ProjectTeam            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  versions     SubmissionVersion[]
  evaluations  SubmissionEvaluation[]
  publications GradePublication[]

  @@unique([milestoneId, teamId])
}

model SubmissionVersion {
  id              Int @id @default(autoincrement())
  submissionId    Int
  version         Int
  repoUrl         String
  reportUrl       String?
  releaseTag      String
  notes           String @default("")
  submittedAt     DateTime
  dueDateSnapshot DateTime?
  lateStatus      SubmissionLateStatus @default(UNKNOWN)
  legacyScore     Int?
  legacyFeedback  String?

  submission MilestoneSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  evaluation SubmissionEvaluation?

  @@unique([submissionId, version])
}

model SubmissionEvaluation {
  id                     Int                @id @default(autoincrement())
  submissionId           Int
  submissionVersion      Int
  score                  Int
  feedback               String
  version                Int                @default(1)
  draftRevision          Int                @default(1)
  publishedDraftRevision Int?
  updatedById            Int
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @default(now()) @updatedAt

  submission             MilestoneSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  contentVersion         SubmissionVersion   @relation(fields: [submissionId, submissionVersion], references: [submissionId, version], onDelete: Cascade)
  updatedBy              User                @relation("EvaluationUpdater", fields: [updatedById], references: [id])
  publications           GradePublication[]

  @@unique([submissionId, submissionVersion])
}

model GradePublication {
  id                Int                  @id @default(autoincrement())
  evaluationId      Int
  submissionId      Int
  submissionVersion Int
  draftRevision     Int
  score             Int
  feedback          String
  publishedById     Int
  publishedAt       DateTime             @default(now())

  evaluation        SubmissionEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  submission        MilestoneSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  publishedBy       User                 @relation("GradePublisher", fields: [publishedById], references: [id])

  @@unique([evaluationId, draftRevision])
}
