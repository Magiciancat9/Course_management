# ==============================================================================
# CoursePMS Server Environment Variables Template (server/.env.example)
# Copy to server/.env for native local development.
# Placeholder values only; replace them locally and never commit real secrets.
# ==============================================================================

PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/course_pms?schema=public"
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-with-secure-random-jwt-secret"
DEMO_USER_PASSWORD="replace-with-local-demo-password"
